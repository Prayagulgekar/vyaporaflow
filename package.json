{
  "name": "vyaporaflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@heroicons/react": "^2.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "predev": "tsx scripts/db.ts predev",
    "dev": "next dev",
    "build": "next build",
    "prestart": "tsx scripts/check-env.ts",
    "start": "next start",
    "db:setup": "tsx scripts/db.ts setup",
    "db:reset": "tsx scripts/db.ts reset",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:status": "tsx scripts/db.ts status",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "test:security": "vitest run tests/integration/rls.test.ts",
    "test:pg": "node -e \"if(!process.env.TEST_DATABASE_URL){console.error('Set TEST_DATABASE_URL to a disposable local PostgreSQL server first (see docs/testing.md)');process.exit(1)}\" && vitest run tests/integration"
  },
  "engines": {
    "node": ">=20.9"
  }
}
