# VyaporaFlow configuration template. Copy to .env.local and fill in.
# .env.local is git-ignored. Never commit real credentials.
# Full reference: docs/configuration.md

# ---------------------------------------------------------------------------
# Mode: "demo" (local, no external services) or "production" (Supabase).
# ---------------------------------------------------------------------------
APP_MODE=demo
NEXT_PUBLIC_APP_NAME=VyaporaFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Demo mode only
# ---------------------------------------------------------------------------
# Embedded PostgreSQL (PGlite) data folder. Persists between restarts.
DEMO_DB_PATH=.data/pglite
# Optional: use a local PostgreSQL server instead of PGlite (never a production database).
# DEMO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/vyaporaflow_demo
DEMO_UPLOAD_DIR=.data/uploads

# ---------------------------------------------------------------------------
# Production mode only (APP_MODE=production). All required; startup fails
# with a clear error if any is missing. There is no fallback to demo data.
# ---------------------------------------------------------------------------
# Public values (safe in the browser):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon public key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
#
# Server-only secret. NEVER prefix with NEXT_PUBLIC_. Supabase pooler string.
# Session pooler (port 5432) locally; Transaction pooler (port 6543) on Vercel.
# Copy the host exactly from the dashboard's Connect panel.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# Optional verified TLS: path to Supabase's CA certificate (no sslmode in DATABASE_URL).
# DATABASE_CA_CERT=supabase-ca.crt
#
# SUPABASE_STORAGE_BUCKET=company-assets
#
# The app does not need SUPABASE_SERVICE_ROLE_KEY. If you add a feature that
# does, keep it server-only and never prefix it with NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------
# Disposable local PostgreSQL for concurrency tests (npm run test:pg).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
